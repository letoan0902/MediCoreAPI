{
  "info": {
    "name": "Medicine & Prescription",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Quản lý Thuốc",
      "item": [
        {
          "name": "Lấy danh sách thuốc",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/medicines" }
          }
        },
        {
          "name": "Tạo thuốc mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Paracetamol 500mg\",\n    \"unit\": \"Viên\",\n    \"description\": \"Thuốc giảm đau, hạ sốt\",\n    \"price\": 1500\n}"
            },
            "url": { "raw": "{{base_url}}/api/medicines" }
          }
        },
        {
          "name": "Cập nhật thuốc",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Paracetamol 500mg (Updated)\",\n    \"unit\": \"Viên\",\n    \"description\": \"Thuốc giảm đau, hạ sốt\",\n    \"price\": 2000\n}"
            },
            "url": { "raw": "{{base_url}}/api/medicines/1" }
          }
        },
        {
          "name": "Xóa thuốc",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/medicines/1" }
          }
        }
      ]
    },
    {
      "name": "Đơn thuốc",
      "item": [
        {
          "name": "Tạo đơn thuốc (Bác sĩ)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"appointmentId\": 1,\n    \"diagnosis\": \"Viêm họng cấp\",\n    \"notes\": \"Uống thuốc sau ăn, nghỉ ngơi 3 ngày\",\n    \"items\": [\n        {\n            \"medicineId\": 1,\n            \"quantity\": 10,\n            \"dosage\": \"2 viên/ngày, sáng tối\",\n            \"notes\": \"Uống sau ăn\"\n        }\n    ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/prescriptions" }
          }
        },
        {
          "name": "Chi tiết đơn thuốc",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/prescriptions/1" }
          }
        },
        {
          "name": "Lịch sử đơn thuốc của tôi (Bệnh nhân)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/prescriptions/my-prescriptions" }
          }
        },
        {
          "name": "Lịch sử đơn thuốc của bệnh nhân (Admin/Doctor)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/prescriptions/patient/1" }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "your_jwt_token_here" }
  ]
}